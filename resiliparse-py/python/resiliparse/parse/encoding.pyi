from collections.abc import Iterable
from typing_extensions import disjoint_base

__all__ = ["EncodingDetector", "bytes_to_str", "detect_encoding", "detect_mime", "map_encoding_to_html5"]

@disjoint_base
class EncodingDetector:
    def __init__(self) -> None: ...
    def update(self, data: bytes) -> None: ...
    def encoding(self, html5_compatible: bool = True) -> str | None: ...
    def reset(self) -> None: ...

def detect_encoding(data: bytes, max_len: int = 131072, html5_compatible: bool = True,
                    from_html_meta: bool = False) -> str | None: ...
def map_encoding_to_html5(encoding: str, fallback_utf8: bool = True) -> str | None: ...
def bytes_to_str(data: bytes, encoding: str = "utf-8", errors: str = "ignore",
                 fallback_encodings: Iterable[str] = ("utf-8", "cp1252"), strip_bom: bool = True) -> str: ...
def detect_mime(data: bytes, max_unprintable: float = 0.05) -> str: ...
